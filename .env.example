# ============================================================
# EcoSort AI — Backend Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to Git — it's in .gitignore
# ============================================================

# --- Gemini AI ---
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- JWT Secret ---
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_chars

# --- PocketBase Connection ---
# Local development:  http://127.0.0.1:8090
# Railway production: This is set automatically by start.js (same container)
# External PocketBase (if hosted separately): https://your-pb.up.railway.app
PB_URL=http://127.0.0.1:8090

# --- CORS Allowed Origins ---
# Comma-separated list of allowed frontend origins
# Your Vercel URL goes here (no trailing slash)
# Example: https://ecoshort-ai.vercel.app,https://ecosortai-production.up.railway.app
ALLOWED_ORIGINS=https://your-vercel-app.vercel.app

# --- Node Environment ---
NODE_ENV=production

# --- Server Port ---
# Railway sets this automatically. Leave as 3002 for local dev.
PORT=3002
